{
  "$schema": "../_lib/schema/experiment.schema.json",
  "module": "queue",
  "title": "queue：有 / 无 SQS（docs/modules/04-compute-async.md#queue 第 5 节）",
  "default": "upload-burst",
  "experiments": [
    {
      "module": "queue",
      "id": "upload-burst",
      "title": "上传突发：sync / memory / sqs 的接口延迟与任务可靠性",
      "kind": "before-after",
      "doc": "docs/modules/04-compute-async.md#queue",
      "description": "主对比是 before（memory + worker）对 after（sqs + worker）；l0（sync + inline）只作为“全部在请求内执行”的参照。故障：before 第 30 秒重启 api（内存队列丢任务），after 第 30 秒 kill -9 worker（SQS 在可见性超时后重投）。--ab 用 X-Compare-Bypass: queue 让一半任务当场执行。",
      "requires": {
        "l0": { "queue.driver": "sync", "image-processing.driver": "inline" },
        "before": { "queue.driver": "memory", "image-processing.driver": "worker" },
        "after": { "queue.driver": "sqs", "image-processing.driver": "worker", "queue.status": ["ok", "degraded"] }
      },
      "labels": {
        "l0": { "title": "sync + inline（参照）", "role": "baseline" },
        "before": { "title": "memory + worker（本地档）", "role": "baseline" },
        "after": { "title": "SQS + worker", "role": "treatment" }
      },
      "ab": { "bypass": "queue", "note": "A = 本次请求入队的任务当场执行，B = 正常入队" },
      "scenario": { "tool": "node", "script": "upload-burst.ts", "vus": 10, "duration": "60s", "warmup": "10s" },
      "params": {
        "count": { "type": "number", "default": 200, "min": 1, "max": 5000, "description": "本轮上传张数上限" },
        "width": { "type": "number", "default": 1600, "min": 16, "max": 8000 },
        "height": { "type": "number", "default": 1200, "min": 16, "max": 8000 },
        "drainTimeoutSec": { "type": "number", "default": 600, "min": 1, "max": 3600, "description": "负载结束后等待全部 READY 的上限（SQS 可见性超时 120 秒）" }
      },
      "metrics": [
        "client.http_req_duration{route:/api/photos/complete}.p95",
        "server.route./api/photos/complete.p95",
        "server.port.queue.dur.p95",
        "biz.photo_time_to_ready.p95",
        "biz.drain_time_ms",
        "host.cpu.p95",
        "biz.jobs_lost"
      ],
      "faults": [
        { "at": "30s", "script": "faults/restart-api.sh", "onlyFor": ["before"], "description": "sudo systemctl restart cloudalbum-api（memory 队列中的任务丢失）" },
        { "at": "30s", "script": "faults/kill-worker.sh", "onlyFor": ["after"], "description": "sudo systemctl kill -s SIGKILL cloudalbum-worker（systemd 随后自动拉起）" }
      ],
      "expect": [
        { "metric": "client.http_req_duration{route:/api/photos/complete}.p95", "direction": "down-or-flat", "note": "memory 与 sqs 都只含入队时间（几十毫秒量级），sqs 多一次 SendMessage 往返；对 l0 则下降一个数量级" },
        { "metric": "biz.photo_time_to_ready.p95", "direction": "up-or-flat", "note": "异步后就绪时间可能略增（排队 + 轮询）；kill worker 后在途消息要等可见性超时" },
        { "metric": "biz.jobs_lost", "direction": "zero", "note": "SQS 在 worker 被杀后重新投递；memory 档重启 api 会丢任务" }
      ],
      "cleanup": "DELETE /api/lab/runs/{runId}/photos"
    },
    {
      "module": "queue",
      "id": "poison",
      "title": "坏消息：接收 3 次后进入 DLQ（需要部署者凭证直接发 SQS 消息）",
      "kind": "functional",
      "doc": "docs/modules/04-compute-async.md#queue",
      "scenario": { "tool": "manual" }
    },
    {
      "module": "queue",
      "id": "dlq-replay",
      "title": "DLQ 重放：start-message-move-task 或“导出到 failed_jobs”",
      "kind": "functional",
      "doc": "docs/modules/04-compute-async.md#queue",
      "scenario": { "tool": "manual" }
    }
  ]
}
