{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atl:schema:taxonomy:v1",
  "title": "ATL catalog taxonomy (05 §8.2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "categories",
    "services",
    "domains",
    "durationBuckets",
    "costTier",
    "provisionSpeed",
    "provisionClasses"
  ],
  "properties": {
    "schema": {
      "const": "atl.taxonomy/v1"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "token",
          "symbol"
        ],
        "properties": {
          "id": {
            "enum": [
              "base",
              "A",
              "B",
              "C",
              "D",
              "E",
              "F"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 20
          },
          "token": {
            "type": "string",
            "pattern": "^--cat-[a-z]+$"
          },
          "symbol": {
            "enum": [
              "square",
              "triangle",
              "diamond",
              "circle",
              "hexagon",
              "plus",
              "bars"
            ]
          }
        }
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "abbr",
          "name",
          "iamPrefix"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,31}$"
          },
          "abbr": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4
          },
          "name": {
            "type": "string",
            "maxLength": 60
          },
          "short": {
            "type": "string",
            "maxLength": 30
          },
          "function": {
            "type": "string",
            "maxLength": 20
          },
          "category": {
            "enum": [
              "base",
              "A",
              "B",
              "C",
              "D",
              "E",
              "F"
            ]
          },
          "module": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,23}$"
          },
          "iamPrefix": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "featureOf": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,31}$"
          },
          "consoleHome": {
            "type": "string",
            "pattern": "^[a-z0-9]+\\.[A-Za-z0-9]+$"
          }
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "weight",
          "track"
        ],
        "properties": {
          "id": {
            "enum": [
              "secure",
              "resilient",
              "performance",
              "cost"
            ]
          },
          "label": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "track": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,31}$"
          }
        }
      }
    },
    "durationBuckets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "enum": [
              "short",
              "medium",
              "long"
            ]
          },
          "label": {
            "type": "string"
          },
          "maxMinutes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "costTier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "highUnits",
        "weights",
        "accountScopedKeys",
        "labels"
      ],
      "properties": {
        "highUnits": {
          "type": "integer",
          "minimum": 1
        },
        "weights": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "accountScopedKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "low",
            "medium",
            "high"
          ],
          "properties": {
            "low": {
              "type": "string"
            },
            "medium": {
              "type": "string"
            },
            "high": {
              "type": "string"
            }
          }
        }
      }
    },
    "provisionSpeed": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "base",
          "fast",
          "medium",
          "slow"
        ]
      }
    },
    "provisionClassRules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heavy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "replacement": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provisionClasses": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "hint"
        ],
        "properties": {
          "id": {
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "label": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          }
        }
      }
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,31}$"
          },
          "title": {
            "type": "string",
            "maxLength": 60
          }
        }
      }
    }
  }
}
