{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atl:schema:track:v2",
  "title": "ATL learning path (tracks-and-catalog §7.3)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "title",
    "summary",
    "stages",
    "completion",
    "certificate"
  ],
  "$defs": {
    "l10n": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh-CN"
      ],
      "properties": {
        "zh-CN": {
          "type": "string",
          "minLength": 1
        },
        "ja": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "atl.track/v2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "title": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        {
          "$ref": "#/$defs/l10n"
        }
      ]
    },
    "summary": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 4,
          "maxLength": 200
        },
        {
          "$ref": "#/$defs/l10n"
        }
      ]
    },
    "audience": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 120
        },
        {
          "$ref": "#/$defs/l10n"
        }
      ]
    },
    "domain": {
      "enum": [
        "secure",
        "resilient",
        "performance",
        "cost"
      ]
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "items"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,31}$"
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "$ref": "#/$defs/l10n"
              }
            ]
          },
          "legacyLabs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30
            }
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "$ref": "#/$defs/l10n"
              }
            ]
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "card",
                    "role"
                  ],
                  "properties": {
                    "card": {
                      "type": "string",
                      "pattern": "^(svc|sc)-[a-z0-9]+(-[a-z0-9]+)*$"
                    },
                    "role": {
                      "enum": [
                        "required",
                        "optional"
                      ]
                    },
                    "legacyLab": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 30
                    },
                    "note": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 120
                        },
                        {
                          "$ref": "#/$defs/l10n"
                        }
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "group",
                    "title",
                    "pick",
                    "cards"
                  ],
                  "properties": {
                    "group": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{1,31}$"
                    },
                    "title": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 40
                        },
                        {
                          "$ref": "#/$defs/l10n"
                        }
                      ]
                    },
                    "pick": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "cards": {
                      "type": "array",
                      "minItems": 2,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "pattern": "^(svc|sc)-[a-z0-9]+(-[a-z0-9]+)*$"
                      }
                    },
                    "legacyLab": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 30
                    },
                    "note": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 120
                        },
                        {
                          "$ref": "#/$defs/l10n"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowManual",
        "minAutoRatio",
        "excludeSelfReported"
      ],
      "properties": {
        "allowManual": {
          "type": "boolean"
        },
        "minAutoRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "excludeSelfReported": {
          "type": "boolean"
        }
      }
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "title"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 40
            },
            {
              "$ref": "#/$defs/l10n"
            }
          ]
        }
      }
    }
  }
}
