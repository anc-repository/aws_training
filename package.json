{
  "name": "cloudalbum",
  "version": "0.1.0",
  "private": true,
  "description": "CloudAlbum: an AWS SAA-C03 learning photo album. Runs fully on a single EC2 (L0); every AWS service is a pluggable module.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "backend",
    "frontend",
    "lambdas/*",
    "experiments",
    "scripts/module-cli"
  ],
  "scripts": {
    "gen:registry": "tsx scripts/registry/build.ts",
    "registry:check": "tsx scripts/registry/check.ts",
    "build": "npm run gen:registry && tsc -b && tsc -p frontend/tsconfig.json --noEmit && tsc -p scripts/registry/tsconfig.json",
    "build:frontend": "npm run build --workspace @cloudalbum/frontend",
    "build:lambdas": "npm run build --workspace @cloudalbum/lambda-image-thumbnail",
    "build:all": "npm run build && npm run build:frontend && npm run build:lambdas",
    "clean": "tsc -b --clean",
    "pretest": "npm run gen:registry",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-config": "tsx backend/src/cli.ts check-config",
    "dev:init": "tsx backend/src/cli.ts dev:init",
    "test:services:up": "docker compose -f docker-compose.test.yml up -d",
    "test:services:down": "docker compose -f docker-compose.test.yml down -v",
    "smoke:l0": "node scripts/smoke/l0.mjs",
    "smoke:selfhost": "node scripts/smoke/selfhost.mjs",
    "smoke:localstack": "node scripts/smoke/localstack.mjs",
    "exp": "npm run exp -w @cloudalbum/experiments --",
    "exp:report": "npm run exp:report -w @cloudalbum/experiments --"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^22.18.0",
    "ajv": "^8.17.1",
    "esbuild": "^0.25.10",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  }
}
