{
  "name": "cloudalbum",
  "version": "0.1.0",
  "private": true,
  "description": "CloudAlbum: an AWS SAA-C03 learning photo album. Runs fully on a single EC2 (L0); every AWS service is a pluggable module.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "backend",
    "frontend",
    "lambdas/*",
    "experiments",
    "scripts/module-cli",
    "platform/shared",
    "platform/api",
    "platform/workflows",
    "platform/infra",
    "platform/workstation",
    "platform/web",
    "scripts/labs"
  ],
  "scripts": {
    "gen:registry": "tsx scripts/registry/build.ts",
    "registry:check": "tsx scripts/registry/check.ts",
    "build": "npm run gen:registry && tsc -b && tsc -p frontend/tsconfig.json --noEmit && tsc -p scripts/registry/tsconfig.json && tsc -p platform/infra/tsconfig.json",
    "build:frontend": "npm run build --workspace @cloudalbum/frontend",
    "build:lambdas": "npm run build --workspace @cloudalbum/lambda-image-thumbnail",
    "build:all": "npm run build && npm run build:frontend && npm run build:lambdas",
    "clean": "tsc -b --clean",
    "pretest": "npm run gen:registry",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-config": "tsx backend/src/cli.ts check-config",
    "dev:init": "tsx backend/src/cli.ts dev:init",
    "test:services:up": "docker compose -f docker-compose.test.yml up -d",
    "test:services:down": "docker compose -f docker-compose.test.yml down -v",
    "smoke:l0": "node scripts/smoke/l0.mjs",
    "smoke:selfhost": "node scripts/smoke/selfhost.mjs",
    "smoke:localstack": "node scripts/smoke/localstack.mjs",
    "smoke:platform": "tsx platform/api/src/dev/smoke-platform.ts",
    "exp": "npm run exp -w @cloudalbum/experiments --",
    "exp:report": "npm run exp:report -w @cloudalbum/experiments --",
    "platform:build": "tsc -b platform/shared platform/workflows platform/api platform/workstation scripts/labs && tsc -p platform/infra/tsconfig.json && node platform/checks/build.mjs && node platform/api/build.mjs && tsx platform/infra/build/merge-template.ts",
    "platform:package": "npm run package -w @atl/infra --",
    "platform:test": "vitest run --project atl-shared --project atl-api --project atl-workflows --project atl-infra --project atl-workstation --project atl-labs-tools",
    "platform:validate": "tsx platform/workflows/src/cli/validate.ts",
    "platform:db:up": "docker compose -f docker-compose.platform.yml up -d --wait",
    "platform:db:down": "docker compose -f docker-compose.platform.yml down -v",
    "platform:db:init": "tsx platform/api/src/dev/create-tables.ts --seed",
    "platform:dev": "tsx platform/api/src/dev-server.ts --dev-mode --seed-catalog",
    "labs:schema": "tsx scripts/labs/src/cli.ts schema",
    "labs:lint": "tsx scripts/labs/src/cli.ts lint",
    "labs:derive": "tsx scripts/labs/src/cli.ts derive",
    "labs:build": "tsx scripts/labs/src/cli.ts build",
    "labs:catalog": "tsx scripts/labs/src/cli.ts catalog",
    "labs:policy": "tsx scripts/labs/src/cli.ts policy"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^22.18.0",
    "ajv": "^8.17.1",
    "esbuild": "^0.25.10",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  }
}
