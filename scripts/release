#!/usr/bin/env bash
# scripts/release <version> [--arch arm64|x86_64] [--out <dir>] [--skip-build] — build the per-architecture release
# archive downloaded by the User Data stub (AppArchiveUrl / AppArchiveSha256; 00-ec2-base.md 6.5).
# Run on Linux (or CloudShell). Layout of cloudalbum-<version>-<arch>.tgz (single top-level directory, --strip-components=1):
#   VERSION  package.json  package-lock.json  node_modules/ (production deps for linux-<arch>, incl. sharp)
#   backend/{package.json,dist}  packages/{contracts,image-core}/{package.json,dist}  frontend/dist
#   infra/ (templates, nginx, systemd, host helpers, userdata/l0-bootstrap.sh, defaults)
#   modules/{registry.yaml,registry.json,hostsetup-order.txt}  scripts/{local-backup.sh,selfhost/}
#   atl/{bin/atl-check,checks/<bundleDigest>/}  experiments/<module>/{lab,faults}/*.sh  .release-manifest.json  (ATL, 06 PM-04)
# Prints the SHA-256 to pass as AppArchiveSha256. Uploading (GitHub Release or the toolchain bucket releases/ mirror) is manual.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
version=${1:-}; shift || true
arch=arm64; out="$ROOT/build/release"; build=yes
while [ $# -gt 0 ]; do
  case "$1" in
    --arch) arch=$2; shift 2 ;;
    --out) out=$2; shift 2 ;;
    --skip-build) build=no; shift ;;
    *) echo "unknown option: $1" >&2; exit 64 ;;
  esac
done
[[ $version =~ ^[A-Za-z0-9._-]+$ ]] || { echo "usage: scripts/release <version> [--arch arm64|x86_64] [--out dir] [--skip-build]" >&2; exit 64; }
case "$arch" in arm64) cpu=arm64 ;; x86_64) cpu=x64 ;; *) echo "--arch must be arm64 or x86_64" >&2; exit 64 ;; esac

name="cloudalbum-$version-$arch"
stage="$out/$name"
rm -rf "$stage"; mkdir -p "$stage"

if [ "$build" = yes ]; then
  (cd "$ROOT" && npm run build && npm run build:frontend)
fi

copy() { mkdir -p "$stage/$(dirname "$1")"; cp -a "$ROOT/$1" "$stage/$1"; }
echo "$version" > "$stage/VERSION"
copy package-lock.json
copy backend/package.json; copy backend/dist
for p in contracts image-core; do copy "packages/$p/package.json"; copy "packages/$p/dist"; done
copy frontend/dist
copy infra
copy modules/registry.yaml
copy scripts/local-backup.sh; copy scripts/selfhost
# remove TypeScript build info and source maps of type declarations (not needed at runtime)
find "$stage" -name '*.tsbuildinfo' -delete

# root package.json restricted to the runtime workspaces
node -e '
  const fs = require("node:fs");
  const pkg = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
  pkg.workspaces = ["packages/*", "backend"];
  delete pkg.devDependencies; pkg.scripts = {};
  fs.writeFileSync(process.argv[2], JSON.stringify(pkg, null, 2) + "\n");
' "$ROOT/package.json" "$stage/package.json"

# registry.json + topological order for run-hostsetup.sh (computed by the module tool from the same registry)
"$ROOT/scripts/module" release-meta --out "$stage/modules"

# ATL check bundle (docs/platform/06 PM-04): atl/bin/atl-check + atl/checks/<bundleDigest>/ travel with the release, so every
# instance that can install CloudAlbum (instance replacement, ASG scale-out, private placement) also has the checks.
# bundleDigest = SHA-256 of manifest.json = the directory name (verified here and again by install-atl-bundle.sh).
atl_digest=null
if [ -f "$ROOT/platform/checks/build.mjs" ]; then
  atl_tmp=$(mktemp -d)
  node "$ROOT/platform/checks/build.mjs" --out "$atl_tmp" >/dev/null
  atl_digest_raw=$(node -e 'process.stdout.write(require(process.argv[1]).bundleDigest)' "$atl_tmp/bundle.json")
  [ "$(sha256sum "$atl_tmp/atl/checks/$atl_digest_raw/manifest.json" | cut -c1-64)" = "$atl_digest_raw" ] \
    || { echo "release: check bundle directory name and manifest digest differ" >&2; exit 1; }
  mkdir -p "$stage/atl"
  cp -R "$atl_tmp/atl/bin" "$atl_tmp/atl/checks" "$stage/atl/"
  rm -f "$stage/atl/bin/atl-check.mjs"                        # dev launcher only
  rm -rf "$atl_tmp"
  atl_digest="\"$atl_digest_raw\""
else
  echo "release: platform/checks is missing, the release ships no ATL check bundle" >&2
fi
# lab-side experiment scripts (PM-41 / PM-42): experiments/<module>/{lab,faults}/*.sh only
for d in "$ROOT"/experiments/*/lab "$ROOT"/experiments/*/faults; do
  [ -d "$d" ] || continue
  rel=${d#"$ROOT"/}; mkdir -p "$stage/$rel"; cp "$d"/*.sh "$stage/$rel/" 2>/dev/null || true
done
# minimum SSM Agent version for interpolationType ENV_VAR (PM-06): filled in after the 07 verification, never guessed here
ssm_min=${SSM_AGENT_MIN_VERSION:-}
node -e '
  const fs = require("node:fs");
  const [file, version, arch, digest, ssm] = process.argv.slice(1);
  fs.writeFileSync(file, JSON.stringify({ schema: "cloudalbum.release-manifest/v1", version, arch, createdAt: new Date().toISOString(),
    atlBundleDigest: digest === "null" ? null : JSON.parse(digest), ssmAgentMinVersion: ssm || null }, null, 2) + "\n");
' "$stage/.release-manifest.json" "$version" "$arch" "$atl_digest" "$ssm_min"

# production dependencies for the target platform (sharp ships prebuilt linux-<arch> binaries)
(cd "$stage" && npm install --omit=dev --no-audit --no-fund --os=linux --cpu="$cpu" --libc=glibc)

chmod 0755 "$stage"/infra/install-host-files.sh "$stage"/infra/userdata/l0-bootstrap.sh "$stage"/infra/host/*.sh \
           "$stage"/infra/host/cloudalbum-* "$stage"/scripts/local-backup.sh "$stage"/scripts/selfhost/*.sh \
           "$stage"/infra/modules/*/host-setup.sh "$stage"/infra/host/cloudalbum "$stage"/infra/host/platform/*.sh \
           "$stage"/atl/bin/atl-check 2>/dev/null || true

tar czf "$out/$name.tgz" -C "$out" "$name"
sha=$(sha256sum "$out/$name.tgz" | awk '{print $1}')
echo "$sha  $name.tgz" > "$out/$name.tgz.sha256"
echo "release: $out/$name.tgz"
echo "AppArchiveSha256=$sha"
