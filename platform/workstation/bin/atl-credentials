#!/bin/bash
# /opt/atl/bin/atl-credentials — credential_process fallback of the learner CLI profile (01 §6.3, 03 §4.6).
# The primary mechanism is credential_source = Ec2InstanceMetadata in ~labuser/.aws/config; this helper is used only when a
# tool does not support it. It forces the instance role (no profile, no config file), assumes ATLLearnerRole as
# atl-<sid>-ws and prints the credential_process JSON; the result is cached in ~/.cache/atl/ (0600) and renewed 5 minutes
# before it expires.
set -euo pipefail
umask 077
sid=""
if [ -r /etc/atl/session.env ]; then
  sid=$(sed -n "s/^ATL_SESSION_ID='\{0,1\}\([a-z0-9]*\)'\{0,1\}$/\1/p" /etc/atl/session.env)
fi
[[ "$sid" =~ ^s[0-9a-hjkmnp-tv-z]{12}$ ]] || { echo "atl-credentials: no session wired on this workstation" >&2; exit 1; }
cache_dir="${HOME}/.cache/atl"
cache="${cache_dir}/credentials-${sid}.json"
mkdir -p "$cache_dir"
if [ -s "$cache" ]; then
  exp=$(jq -r '.Expiration // empty' "$cache" 2>/dev/null || true)
  if [ -n "$exp" ] && [ "$(date -u -d "$exp" +%s 2>/dev/null || echo 0)" -gt $(( $(date -u +%s) + 300 )) ]; then
    cat "$cache"
    exit 0
  fi
fi
token=$(curl -sS -m 3 -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 60')
acct=$(curl -sS -m 3 -H "X-aws-ec2-metadata-token: $token" http://169.254.169.254/latest/dynamic/instance-identity/document | jq -r .accountId)
[[ "$acct" =~ ^[0-9]{12}$ ]] || { echo "atl-credentials: cannot read the account id from IMDS" >&2; exit 1; }
out=$(env -u AWS_PROFILE -u AWS_ACCESS_KEY_ID -u AWS_SECRET_ACCESS_KEY -u AWS_SESSION_TOKEN \
  AWS_CONFIG_FILE=/dev/null AWS_SHARED_CREDENTIALS_FILE=/dev/null \
  aws sts assume-role --role-arn "arn:aws:iam::${acct}:role/ATLLearnerRole" --role-session-name "atl-${sid}-ws" \
  --duration-seconds 3600 --output json)
printf '%s' "$out" | jq '{Version: 1, AccessKeyId: .Credentials.AccessKeyId, SecretAccessKey: .Credentials.SecretAccessKey,
  SessionToken: .Credentials.SessionToken, Expiration: .Credentials.Expiration}' > "${cache}.tmp"
mv "${cache}.tmp" "$cache"
cat "$cache"
