{
  "//": "01 §6.4 inline policy ATLLearnerIam of ATLLearnerRole. Resource * is narrowed by ATLLearnerBoundary (PrincipalWritesNeedWorkloadBoundary, PassOnlyLabRoles, AssumeOnlyLabRoles) and ATLLearnerGuardrails (LabIamResourcesOnly). Tag*/Untag* on policies and instance profiles are needed when CloudFormation propagates stack tags (scripts/module on the workstation).",
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "LabIam", "Effect": "Allow", "Resource": "*",
      "Action": ["iam:CreateRole", "iam:DeleteRole", "iam:AttachRolePolicy", "iam:DetachRolePolicy", "iam:PutRolePolicy", "iam:DeleteRolePolicy",
                 "iam:PutRolePermissionsBoundary", "iam:TagRole", "iam:UntagRole", "iam:UpdateRole*", "iam:UpdateAssumeRolePolicy",
                 "iam:CreatePolicy", "iam:CreatePolicyVersion", "iam:DeletePolicy", "iam:DeletePolicyVersion", "iam:SetDefaultPolicyVersion",
                 "iam:TagPolicy", "iam:UntagPolicy", "iam:CreateInstanceProfile", "iam:DeleteInstanceProfile", "iam:AddRoleToInstanceProfile",
                 "iam:RemoveRoleFromInstanceProfile", "iam:TagInstanceProfile", "iam:UntagInstanceProfile", "iam:PassRole", "iam:Get*",
                 "iam:List*", "iam:SimulatePrincipalPolicy"] },
    { "Sid": "DemoUserPolicies", "Effect": "Allow", "Action": ["iam:AttachUserPolicy", "iam:DetachUserPolicy"],
      "Resource": "arn:${AWS::Partition}:iam::${AWS::AccountId}:user/cloudalbum/*" }
  ]
}
