{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowLabServices",
      "Effect": "Allow",
      "Action": [
        "access-analyzer:Get*",
        "access-analyzer:List*",
        "acm:*",
        "apigateway:*",
        "application-autoscaling:*",
        "athena:*",
        "autoscaling:*",
        "backup:*",
        "backup-storage:*",
        "budgets:*",
        "ce:Describe*",
        "ce:Get*",
        "ce:List*",
        "cloudfront:*",
        "cloudshell:*",
        "cloudtrail:*",
        "cloudwatch:*",
        "cognito-identity:*",
        "cognito-idp:*",
        "config:*",
        "dynamodb:*",
        "ec2:*",
        "ec2-instance-connect:*",
        "ec2messages:*",
        "elasticache:*",
        "elasticfilesystem:*",
        "elasticloadbalancing:*",
        "events:*",
        "execute-api:*",
        "firehose:*",
        "glue:*",
        "guardduty:*",
        "health:Describe*",
        "imagebuilder:*",
        "inspector2:*",
        "kms:*",
        "lambda:*",
        "logs:*",
        "pricing:*",
        "rds:*",
        "rds-db:*",
        "rekognition:*",
        "resource-groups:*",
        "route53:*",
        "s3:*",
        "scheduler:*",
        "secretsmanager:*",
        "servicequotas:Get*",
        "servicequotas:List*",
        "ses:*",
        "sns:*",
        "sqs:*",
        "ssm:*",
        "ssmmessages:*",
        "states:*",
        "tag:*",
        "wafv2:*",
        "xray:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowIamReadAndIdentity",
      "Effect": "Allow",
      "Action": [
        "iam:Get*",
        "iam:List*",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowAssumeLabRoles",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": [
        "arn:aws:iam::111122223333:role/CloudAlbum*",
        "arn:aws:iam::111122223333:role/*cloudalbum-*"
      ]
    },
    {
      "Sid": "DenyOtherRegions",
      "Effect": "Deny",
      "NotAction": [
        "iam:*",
        "sts:*",
        "cloudfront:*",
        "route53:*",
        "budgets:*",
        "ce:*",
        "health:*",
        "pricing:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "ap-northeast-1",
            "us-east-1",
            "ap-northeast-3"
          ]
        }
      }
    },
    {
      "Sid": "UsEast1EdgeOnly",
      "Effect": "Deny",
      "NotAction": [
        "iam:*",
        "sts:*",
        "cloudfront:*",
        "route53:*",
        "budgets:*",
        "ce:*",
        "health:*",
        "pricing:*",
        "acm:*",
        "wafv2:*",
        "cloudwatch:*",
        "logs:*",
        "sns:*",
        "s3:ListAllMyBuckets",
        "s3:GetBucketLocation",
        "cloudtrail:LookupEvents",
        "cloudformation:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "DrRegionLimited",
      "Effect": "Deny",
      "NotAction": [
        "iam:*",
        "sts:*",
        "backup:*",
        "backup-storage:*",
        "kms:*",
        "s3:*",
        "tag:GetResources",
        "cloudformation:*",
        "ec2:Describe*",
        "ec2:*Snapshot*",
        "ec2:CreateTags",
        "ec2:CreateVolume",
        "ec2:DeleteVolume",
        "rds:Describe*",
        "rds:*DBSnapshot*",
        "rds:AddTagsToResource",
        "rds:CreateDBInstanceReadReplica",
        "rds:DeleteDBInstance",
        "rds:*DBSubnetGroup",
        "cloudwatch:Get*",
        "cloudwatch:List*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-3"
        }
      }
    },
    {
      "Sid": "DenyPlatformByName",
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:iam::*:*/ATL*",
        "arn:aws:s3:::atl-*",
        "arn:aws:dynamodb:*:*:table/atl-*",
        "arn:aws:lambda:*:*:function:atl-*",
        "arn:aws:states:*:*:*:atl-*",
        "arn:aws:codebuild:*:*:project/atl-*",
        "arn:aws:cloudformation:*:*:stack/atl*",
        "arn:aws:scheduler:*:*:schedule*/atl-*",
        "arn:aws:logs:*:*:log-group:/atl/*",
        "arn:aws:logs:*:*:log-group:/aws/*/atl-*",
        "arn:aws:ssm:*:*:parameter/atl/*",
        "arn:aws:sns:*:*:atl-*",
        "arn:aws:sqs:*:*:atl-*",
        "arn:aws:kms:*:*:alias/atl-*",
        "arn:aws:events:*:*:*/atl-*",
        "arn:aws:budgets::*:budget/atl-*",
        "arn:aws:access-analyzer:*:*:analyzer/atl-*"
      ]
    },
    {
      "Sid": "DenyPlatformByTag",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/atl:component": [
            "platform",
            "workstation"
          ]
        }
      }
    },
    {
      "Sid": "DenyPlatformByArn",
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:cloudfront::*:*/E2EXAMPLEATL01",
        "arn:aws:cloudfront::*:function/atl-*",
        "arn:aws:cloudfront::*:*/11111111-aaaa-4bbb-8ccc-000000000001",
        "arn:aws:cloudfront::*:*/11111111-aaaa-4bbb-8ccc-000000000002",
        "arn:aws:cloudfront::*:*/11111111-aaaa-4bbb-8ccc-000000000003",
        "arn:aws:cloudfront::*:*/22222222-aaaa-4bbb-8ccc-000000000001",
        "arn:aws:cloudfront::*:*/E3EXAMPLEOAC01",
        "arn:aws:cognito-idp:*:*:userpool/ap-northeast-1_EXAMPLE12",
        "arn:aws:apigateway:*::/apis/a1b2c3d4e5*",
        "arn:aws:kms:*:*:key/1234abcd-12ab-34cd-56ef-1234567890ab"
      ]
    },
    {
      "Sid": "ProtectSsmPlatform",
      "Effect": "Deny",
      "Action": [
        "ssm:UpdateDocument*",
        "ssm:DeleteDocument",
        "ssm:ModifyDocumentPermission",
        "ssm:UpdateAssociation",
        "ssm:DeleteAssociation",
        "ssm:AddTagsToResource",
        "ssm:RemoveTagsFromResource"
      ],
      "Resource": [
        "arn:aws:ssm:*:111122223333:document/ATL-*",
        "arn:aws:ssm:*:*:association/00000000-0000-4000-8000-000000000000"
      ]
    },
    {
      "Sid": "ProtectComponentTag",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/atl:component": [
            "platform",
            "workstation"
          ]
        }
      }
    },
    {
      "Sid": "DenySessionSecrets",
      "Effect": "Deny",
      "Action": "ssm:GetParameter*",
      "Resource": [
        "arn:aws:ssm:*:111122223333:parameter/cloudalbum/*/atl/*",
        "arn:aws:ssm:*:111122223333:parameter/ec2/keypair/*"
      ]
    },
    {
      "Sid": "DenyLabStateStore",
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:s3:::cloudalbum-lab-state-111122223333-ap-northeast-1",
        "arn:aws:s3:::cloudalbum-lab-state-111122223333-ap-northeast-1/*",
        "arn:aws:dynamodb:ap-northeast-1:111122223333:table/cloudalbum-lab-locks"
      ]
    },
    {
      "Sid": "ProtectRecordings",
      "Effect": "Deny",
      "NotAction": [
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:Describe*"
      ],
      "Resource": "arn:aws:logs:*:111122223333:log-group:/atl-recordings/*"
    },
    {
      "Sid": "LimitEc2InstanceTypes",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:StartInstances"
      ],
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringNotLike": {
          "ec2:InstanceType": [
            "t3.micro",
            "t3.small",
            "t3.medium",
            "t4g.micro",
            "t4g.small",
            "t4g.medium"
          ]
        }
      }
    },
    {
      "Sid": "LimitDbClasses",
      "Effect": "Deny",
      "Action": [
        "rds:CreateDBInstance",
        "rds:CreateDBInstanceReadReplica",
        "rds:ModifyDBInstance",
        "rds:RestoreDBInstance*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotLike": {
          "rds:DatabaseClass": [
            "db.t3.micro",
            "db.t4g.micro",
            "db.t4g.small"
          ]
        },
        "Null": {
          "rds:DatabaseClass": "false"
        }
      }
    },
    {
      "Sid": "LimitCacheNodeTypes",
      "Effect": "Deny",
      "Action": [
        "elasticache:CreateCacheCluster",
        "elasticache:CreateReplicationGroup",
        "elasticache:ModifyCacheCluster",
        "elasticache:ModifyReplicationGroup"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotLike": {
          "elasticache:CacheNodeType": [
            "cache.t3.micro",
            "cache.t4g.micro",
            "cache.t4g.small"
          ]
        },
        "Null": {
          "elasticache:CacheNodeType": "false"
        }
      }
    },
    {
      "Sid": "LimitAsgSize",
      "Effect": "Deny",
      "Action": [
        "autoscaling:CreateAutoScalingGroup",
        "autoscaling:UpdateAutoScalingGroup"
      ],
      "Resource": "*",
      "Condition": {
        "NumericGreaterThan": {
          "autoscaling:MaxSize": "4"
        }
      }
    }
  ]
}
