{
  "//": "01 §6.5 ATLLearnerBoundary. Rendered by build/gen-policies.ts: strings with ${…} become Fn::Sub (IAM variables are written ${!aws:…}); \"@@NAME\" is a macro (see MACROS in gen-policies.ts); \"//if\" wraps a statement in Fn::If <condition>.",
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "AllowLabServices", "Effect": "Allow", "Action": "@@LAB_SERVICE_ACTIONS", "Resource": "*" },
    { "Sid": "DenyOtherRegions", "Effect": "Deny", "NotAction": "@@GLOBAL_SERVICE_ACTIONS", "Resource": "*",
      "Condition": { "StringNotEquals": { "aws:RequestedRegion": "@@ALLOWED_REGIONS" } } },
    { "//if": "NotUsEast1", "Sid": "UsEast1EdgeOnly", "Effect": "Deny", "NotAction": "@@US_EAST_1_EDGE_ACTIONS", "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "us-east-1" } } },
    { "//if": "HasDrRegion", "Sid": "DrRegionLimited", "Effect": "Deny", "NotAction": "@@DR_REGION_ACTIONS", "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "${DrRegion}" } } },
    { "Sid": "DenyPlatformByName", "Effect": "Deny", "Action": "*", "Resource": "@@PLATFORM_NAME_RESOURCES" },
    { "Sid": "DenyPlatformByTag", "Effect": "Deny", "NotAction": "@@PLATFORM_TAG_EXEMPT_ACTIONS", "Resource": "*",
      "Condition": { "StringEquals": { "aws:ResourceTag/atl:component": ["platform", "workstation"] } } },
    { "Sid": "ProtectComponentTag", "Effect": "Deny", "Action": "*", "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestTag/atl:component": ["platform", "workstation"] } } },
    { "Sid": "DenyIamUsersAndAccountIam", "Effect": "Deny", "Action": "@@ACCOUNT_IAM_ACTIONS", "Resource": "*" },
    { "Sid": "PrincipalWritesNeedWorkloadBoundary", "Effect": "Deny",
      "Action": ["iam:CreateRole", "iam:PutRolePermissionsBoundary", "iam:AttachRolePolicy", "iam:DetachRolePolicy",
                 "iam:PutRolePolicy", "iam:DeleteRolePolicy", "iam:AttachUserPolicy", "iam:DetachUserPolicy",
                 "iam:PutUserPolicy", "iam:DeleteUserPolicy"],
      "Resource": "*",
      "Condition": { "StringNotEquals": { "iam:PermissionsBoundary": "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/ATLWorkloadBoundary" } } },
    { "Sid": "NoBoundaryRemoval", "Effect": "Deny",
      "Action": ["iam:DeleteRolePermissionsBoundary", "iam:DeleteUserPermissionsBoundary", "iam:PutUserPermissionsBoundary"], "Resource": "*" },
    { "Sid": "PassOnlyLabRoles", "Effect": "Deny", "Action": "iam:PassRole",
      "NotResource": ["arn:${AWS::Partition}:iam::*:role/CloudAlbum*", "arn:${AWS::Partition}:iam::*:role/*cloudalbum-*"] },
    { "Sid": "AssumeOnlyLabRoles", "Effect": "Deny", "Action": "sts:AssumeRole",
      "NotResource": ["arn:${AWS::Partition}:iam::${AWS::AccountId}:role/CloudAlbum*", "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/*cloudalbum-*"] },
    { "Sid": "LimitEc2InstanceTypes", "Effect": "Deny", "Action": ["ec2:RunInstances", "ec2:StartInstances"],
      "Resource": "arn:${AWS::Partition}:ec2:*:*:instance/*",
      "Condition": { "StringNotLike": { "ec2:InstanceType": { "Ref": "AllowedInstanceTypes" } } } },
    { "Sid": "LimitDbClasses", "Effect": "Deny", "Action": "@@RDS_INSTANCE_WRITE_ACTIONS", "Resource": "*",
      "Condition": { "StringNotLike": { "rds:DatabaseClass": { "Ref": "AllowedDbClasses" } }, "Null": { "rds:DatabaseClass": "false" } } },
    { "Sid": "LimitCacheNodeTypes", "Effect": "Deny",
      "Action": ["elasticache:CreateCacheCluster", "elasticache:CreateReplicationGroup", "elasticache:ModifyCacheCluster", "elasticache:ModifyReplicationGroup"],
      "Resource": "*",
      "Condition": { "StringNotLike": { "elasticache:CacheNodeType": { "Ref": "AllowedCacheNodeTypes" } }, "Null": { "elasticache:CacheNodeType": "false" } } },
    { "Sid": "LimitAsgSize", "Effect": "Deny", "Action": ["autoscaling:CreateAutoScalingGroup", "autoscaling:UpdateAutoScalingGroup"], "Resource": "*",
      "Condition": { "NumericGreaterThan": { "autoscaling:MaxSize": "${AsgMaxSizeLimit}" } } }
  ]
}
