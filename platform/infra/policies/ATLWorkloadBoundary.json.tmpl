{
  "//": "01 §6.6 ATLWorkloadBoundary: CloudAlbumAppRole, every role created by learners or module stacks, and the keys-mode demo user. No cloudformation:*, IAM read only, STS only GetCallerIdentity + AssumeRole on lab roles. The SSM association and ATL-* documents are protected by ProtectSsmPlatform (not by DenyPlatformByArn) because the SSM Agent on lab instances reads them.",
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "AllowLabServices", "Effect": "Allow", "Action": "@@WORKLOAD_SERVICE_ACTIONS", "Resource": "*" },
    { "Sid": "AllowIamReadAndIdentity", "Effect": "Allow", "Action": ["iam:Get*", "iam:List*", "sts:GetCallerIdentity"], "Resource": "*" },
    { "Sid": "AllowAssumeLabRoles", "Effect": "Allow", "Action": "sts:AssumeRole",
      "Resource": ["arn:${AWS::Partition}:iam::${AWS::AccountId}:role/CloudAlbum*", "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/*cloudalbum-*"] },
    { "Sid": "DenyOtherRegions", "Effect": "Deny", "NotAction": "@@GLOBAL_SERVICE_ACTIONS", "Resource": "*",
      "Condition": { "StringNotEquals": { "aws:RequestedRegion": "@@ALLOWED_REGIONS" } } },
    { "//if": "NotUsEast1", "Sid": "UsEast1EdgeOnly", "Effect": "Deny", "NotAction": "@@US_EAST_1_EDGE_ACTIONS", "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "us-east-1" } } },
    { "//if": "HasDrRegion", "Sid": "DrRegionLimited", "Effect": "Deny", "NotAction": "@@DR_REGION_ACTIONS", "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "${DrRegion}" } } },
    { "Sid": "DenyPlatformByName", "Effect": "Deny", "Action": "*", "Resource": "@@PLATFORM_NAME_RESOURCES" },
    { "Sid": "DenyPlatformByTag", "Effect": "Deny", "Action": "*", "Resource": "*",
      "Condition": { "StringEquals": { "aws:ResourceTag/atl:component": ["platform", "workstation"] } } },
    { "Sid": "DenyPlatformByArn", "Effect": "Deny", "Action": "*", "Resource": "@@PLATFORM_ARNS_NO_ASSOCIATION" },
    { "Sid": "ProtectSsmPlatform", "Effect": "Deny",
      "Action": ["ssm:UpdateDocument*", "ssm:DeleteDocument", "ssm:ModifyDocumentPermission", "ssm:UpdateAssociation", "ssm:DeleteAssociation",
                 "ssm:AddTagsToResource", "ssm:RemoveTagsFromResource"],
      "Resource": ["arn:${AWS::Partition}:ssm:*:${AWS::AccountId}:document/ATL-*",
                   "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:association/${PrepareInstanceAssociation}"] },
    { "Sid": "ProtectComponentTag", "Effect": "Deny", "Action": "*", "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestTag/atl:component": ["platform", "workstation"] } } },
    { "Sid": "DenySessionSecrets", "Effect": "Deny", "Action": "ssm:GetParameter*",
      "Resource": ["arn:${AWS::Partition}:ssm:*:${AWS::AccountId}:parameter/cloudalbum/*/atl/*",
                   "arn:${AWS::Partition}:ssm:*:${AWS::AccountId}:parameter/ec2/keypair/*"] },
    { "Sid": "DenyLabStateStore", "Effect": "Deny", "Action": "*",
      "Resource": ["arn:${AWS::Partition}:s3:::${LabStateBucket}", "arn:${AWS::Partition}:s3:::${LabStateBucket}/*", "${LabLockTable.Arn}"] },
    { "Sid": "ProtectRecordings", "Effect": "Deny", "NotAction": ["logs:CreateLogStream", "logs:PutLogEvents", "logs:Describe*"],
      "Resource": "arn:${AWS::Partition}:logs:*:${AWS::AccountId}:log-group:/atl-recordings/*" },
    { "Sid": "LimitEc2InstanceTypes", "Effect": "Deny", "Action": ["ec2:RunInstances", "ec2:StartInstances"],
      "Resource": "arn:${AWS::Partition}:ec2:*:*:instance/*",
      "Condition": { "StringNotLike": { "ec2:InstanceType": { "Ref": "AllowedInstanceTypes" } } } },
    { "Sid": "LimitDbClasses", "Effect": "Deny", "Action": "@@RDS_INSTANCE_WRITE_ACTIONS", "Resource": "*",
      "Condition": { "StringNotLike": { "rds:DatabaseClass": { "Ref": "AllowedDbClasses" } }, "Null": { "rds:DatabaseClass": "false" } } },
    { "Sid": "LimitCacheNodeTypes", "Effect": "Deny",
      "Action": ["elasticache:CreateCacheCluster", "elasticache:CreateReplicationGroup", "elasticache:ModifyCacheCluster", "elasticache:ModifyReplicationGroup"],
      "Resource": "*",
      "Condition": { "StringNotLike": { "elasticache:CacheNodeType": { "Ref": "AllowedCacheNodeTypes" } }, "Null": { "elasticache:CacheNodeType": "false" } } },
    { "Sid": "LimitAsgSize", "Effect": "Deny", "Action": ["autoscaling:CreateAutoScalingGroup", "autoscaling:UpdateAutoScalingGroup"], "Resource": "*",
      "Condition": { "NumericGreaterThan": { "autoscaling:MaxSize": "${AsgMaxSizeLimit}" } } }
  ]
}
