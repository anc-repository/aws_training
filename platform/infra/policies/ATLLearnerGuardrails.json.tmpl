{
  "//": "01 §6.5 ATLLearnerGuardrails (customer managed policy attached to ATLLearnerRole; Deny statements moved out of the boundary).",
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "NoCommitments", "Effect": "Deny", "Resource": "*",
      "Action": ["ec2:Purchase*", "ec2:AllocateHosts", "ec2:CreateCapacityReservation*", "rds:PurchaseReserved*",
                 "elasticache:PurchaseReserved*", "dynamodb:PurchaseReserved*"] },
    { "Sid": "ProtectAppRole", "Effect": "Deny",
      "Action": ["iam:DeleteRole", "iam:UpdateAssumeRolePolicy", "iam:TagRole", "iam:UntagRole", "iam:DeleteInstanceProfile",
                 "iam:RemoveRoleFromInstanceProfile"],
      "Resource": ["arn:${AWS::Partition}:iam::${AWS::AccountId}:role/CloudAlbumAppRole",
                   "arn:${AWS::Partition}:iam::${AWS::AccountId}:instance-profile/CloudAlbumAppRole"] },
    { "Sid": "KeepPlatformChannel", "Effect": "Deny", "Action": "iam:DetachRolePolicy",
      "Resource": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/CloudAlbumAppRole",
      "Condition": { "ArnEquals": { "iam:PolicyARN": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore" } } },
    { "Sid": "KeepInstanceProfiles", "Effect": "Deny",
      "Action": ["ec2:DisassociateIamInstanceProfile", "ec2:ReplaceIamInstanceProfileAssociation"], "Resource": "*",
      "Condition": { "StringEquals": { "ec2:ResourceTag/atl:role": ["lab-app", "workstation"] } } },
    { "Sid": "ProtectNonLabTrails", "Effect": "Deny",
      "Action": ["cloudtrail:StopLogging", "cloudtrail:DeleteTrail", "cloudtrail:UpdateTrail", "cloudtrail:Put*Selectors"],
      "NotResource": "arn:${AWS::Partition}:cloudtrail:*:${AWS::AccountId}:trail/cloudalbum-*" },
    { "Sid": "ProtectAtlDocuments", "Effect": "Deny",
      "Action": ["ssm:UpdateDocument*", "ssm:DeleteDocument", "ssm:ModifyDocumentPermission", "ssm:AddTagsToResource",
                 "ssm:RemoveTagsFromResource"],
      "Resource": "arn:${AWS::Partition}:ssm:*:${AWS::AccountId}:document/ATL-*" },
    { "Sid": "ProtectRecordings", "Effect": "Deny", "Action": "@@RECORDING_DESTRUCTIVE_ACTIONS",
      "Resource": "arn:${AWS::Partition}:logs:*:${AWS::AccountId}:log-group:/atl-recordings/*" },
    { "Sid": "ProtectLabStateStore", "Effect": "Deny",
      "NotAction": ["s3:ListBucket", "s3:ListBucketVersions", "s3:GetBucketLocation", "s3:GetBucketVersioning", "s3:GetBucketPolicy",
                    "dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:DeleteItem", "dynamodb:ConditionCheckItem",
                    "dynamodb:Query", "dynamodb:DescribeTable"],
      "Resource": ["arn:${AWS::Partition}:s3:::${LabStateBucket}", "${LabLockTable.Arn}"] },
    { "Sid": "KeepAtlTags", "Effect": "Deny", "Action": "*", "Resource": "*",
      "Condition": {
        "ForAnyValue:StringEquals": { "aws:TagKeys": ["atl:session-id", "atl:lab-id", "atl:env-id", "atl:component"] },
        "Null": { "aws:RequestTag/atl:session-id": "true", "aws:RequestTag/atl:lab-id": "true",
                  "aws:RequestTag/atl:env-id": "true", "aws:RequestTag/atl:component": "true" } } },
    { "Sid": "ProtectRoleTag", "Effect": "Deny", "Action": "*", "Resource": "*",
      "Condition": {
        "ForAnyValue:StringEquals": { "aws:TagKeys": ["atl:role", "atl:active-session-id"] },
        "ForAllValues:StringNotEquals": { "aws:CalledVia": ["cloudformation.amazonaws.com"] } } },
    { "Sid": "LabIamResourcesOnly", "Effect": "Deny",
      "Action": ["iam:DeleteRole", "iam:UpdateRole", "iam:UpdateRoleDescription", "iam:UpdateAssumeRolePolicy", "iam:TagRole",
                 "iam:UntagRole", "iam:CreatePolicyVersion", "iam:DeletePolicy", "iam:DeletePolicyVersion", "iam:SetDefaultPolicyVersion",
                 "iam:AddRoleToInstanceProfile", "iam:RemoveRoleFromInstanceProfile", "iam:DeleteInstanceProfile"],
      "NotResource": ["arn:${AWS::Partition}:iam::${AWS::AccountId}:role/CloudAlbum*", "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/*cloudalbum-*",
                      "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/CloudAlbum*", "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/*cloudalbum-*",
                      "arn:${AWS::Partition}:iam::${AWS::AccountId}:instance-profile/CloudAlbum*",
                      "arn:${AWS::Partition}:iam::${AWS::AccountId}:instance-profile/*cloudalbum-*"] },
    { "Sid": "DenyPlatformByArn", "Effect": "Deny", "Action": "*", "Resource": "@@PLATFORM_ARNS" },
    { "Sid": "DenyInternalRoutes", "Effect": "Deny", "Action": "execute-api:Invoke",
      "Resource": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${HttpApi}/*/*/api/v1/internal/*" },
    { "//if": "HasDrRegion", "Sid": "DrRegionLabStacksOnly", "Effect": "Deny", "Action": "@@STACK_WRITE_ACTIONS",
      "NotResource": "arn:${AWS::Partition}:cloudformation:${DrRegion}:${AWS::AccountId}:stack/cloudalbum-*/*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "${DrRegion}" } } },
    { "//if": "NotUsEast1", "Sid": "UsEast1LabStacksOnly", "Effect": "Deny", "Action": "@@STACK_WRITE_ACTIONS",
      "NotResource": "arn:${AWS::Partition}:cloudformation:us-east-1:${AWS::AccountId}:stack/cloudalbum-*/*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "us-east-1" } } }
  ]
}
