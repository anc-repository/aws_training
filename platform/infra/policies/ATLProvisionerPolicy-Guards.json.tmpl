{
  "//": "01 §6.7 #2: Deny statements of the provisioner that do not fit into ATLProvisionerBoundary (6,144 characters). Attached to ATLProvisionerRole as an identity policy (name pattern ATLProvisionerPolicy-*); a Deny here is as effective for the role's sessions (runner, reaper) as one in the boundary. Bucket names are exact here because a wildcard such as atl-data-* would also match the objects under runs/ and archive/.",
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "ArtifactsReadOnly", "Effect": "Deny", "NotAction": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:${AWS::Partition}:s3:::atl-artifacts-*" },
    { "Sid": "DataRunsAndArchiveOnly", "Effect": "Deny", "Action": "*",
      "Resource": ["arn:${AWS::Partition}:s3:::${DataBucket}", "arn:${AWS::Partition}:s3:::${DataBucket}/reports/*",
                   "arn:${AWS::Partition}:s3:::${DataBucket}/experiments/*", "arn:${AWS::Partition}:s3:::${DataBucket}/evidence/*",
                   "arn:${AWS::Partition}:s3:::${DataBucket}/exports/*"] },
    { "Sid": "DenyPlatformByArn", "Effect": "Deny", "Action": "*", "Resource": "@@PLATFORM_ARNS" },
    { "Sid": "DenyAccountIam", "Effect": "Deny", "Action": "@@ACCOUNT_IAM_ACTIONS_NO_USERS", "Resource": "*" },
    { "Sid": "UsersOnlyUnderLabPath", "Effect": "Deny", "Action": ["iam:CreateUser", "iam:CreateAccessKey", "iam:UpdateAccessKey"],
      "NotResource": "arn:${AWS::Partition}:iam::${AWS::AccountId}:user/cloudalbum/*" },
    { "Sid": "LimitEc2InstanceTypes", "Effect": "Deny", "Action": ["ec2:RunInstances", "ec2:StartInstances"],
      "Resource": "arn:${AWS::Partition}:ec2:*:*:instance/*",
      "Condition": { "StringNotLike": { "ec2:InstanceType": { "Ref": "AllowedInstanceTypes" } } } },
    { "Sid": "LimitDbClasses", "Effect": "Deny", "Action": "@@RDS_INSTANCE_WRITE_ACTIONS", "Resource": "*",
      "Condition": { "StringNotLike": { "rds:DatabaseClass": { "Ref": "AllowedDbClasses" } }, "Null": { "rds:DatabaseClass": "false" } } },
    { "Sid": "LimitCacheNodeTypes", "Effect": "Deny",
      "Action": ["elasticache:CreateCacheCluster", "elasticache:CreateReplicationGroup", "elasticache:ModifyCacheCluster", "elasticache:ModifyReplicationGroup"],
      "Resource": "*",
      "Condition": { "StringNotLike": { "elasticache:CacheNodeType": { "Ref": "AllowedCacheNodeTypes" } }, "Null": { "elasticache:CacheNodeType": "false" } } },
    { "Sid": "LimitAsgSize", "Effect": "Deny", "Action": ["autoscaling:CreateAutoScalingGroup", "autoscaling:UpdateAutoScalingGroup"], "Resource": "*",
      "Condition": { "NumericGreaterThan": { "autoscaling:MaxSize": "${AsgMaxSizeLimit}" } } }
  ]
}
