{
  "//": "01 §6.7 #2 ATLProvisionerBoundary: same region limits as the learner boundary (stack writes in us-east-1 / the DR region only for cloudalbum-*), platform protection by name and tag (value platform only); may manage the workstation (atl-ws-* stacks, atl:component=workstation, PassRole ATLWorkstationRole) and keys-mode demo users under /cloudalbum/. The boundary is limited to 6,144 characters, so the remaining Deny statements (bucket prefixes, DenyPlatformByArn, account IAM, instance limits) live in the identity policy ATLProvisionerPolicy-Guards (same effect for the role's own sessions, like the learner guardrails of 01 §6.5).",
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "AllowLabServices", "Effect": "Allow", "Action": "@@PROVISIONER_SERVICE_ACTIONS", "Resource": "*" },
    { "Sid": "DenyOtherRegions", "Effect": "Deny", "NotAction": "@@GLOBAL_SERVICE_ACTIONS", "Resource": "*",
      "Condition": { "StringNotEquals": { "aws:RequestedRegion": "@@ALLOWED_REGIONS" } } },
    { "//if": "NotUsEast1", "Sid": "UsEast1EdgeOnly", "Effect": "Deny", "NotAction": "@@US_EAST_1_EDGE_ACTIONS", "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "us-east-1" } } },
    { "//if": "HasDrRegion", "Sid": "DrRegionLimited", "Effect": "Deny", "NotAction": "@@DR_REGION_ACTIONS", "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "${DrRegion}" } } },
    { "//if": "NotUsEast1", "Sid": "UsEast1LabStacksOnly", "Effect": "Deny", "Action": "@@STACK_WRITE_ACTIONS",
      "NotResource": "arn:${AWS::Partition}:cloudformation:us-east-1:${AWS::AccountId}:stack/cloudalbum-*/*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "us-east-1" } } },
    { "//if": "HasDrRegion", "Sid": "DrRegionLabStacksOnly", "Effect": "Deny", "Action": "@@STACK_WRITE_ACTIONS",
      "NotResource": "arn:${AWS::Partition}:cloudformation:${DrRegion}:${AWS::AccountId}:stack/cloudalbum-*/*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "${DrRegion}" } } },
    { "Sid": "DenyPlatformByName", "Effect": "Deny", "Action": "*", "Resource": "@@PROVISIONER_PLATFORM_NAME_RESOURCES" },
    { "Sid": "DenyPlatformRoles", "Effect": "Deny", "NotAction": ["iam:PassRole", "iam:GetRole", "iam:GetInstanceProfile"],
      "Resource": ["arn:${AWS::Partition}:iam::*:role/ATL*", "arn:${AWS::Partition}:iam::*:instance-profile/ATL*"] },
    { "Sid": "DenyPlatformByTag", "Effect": "Deny", "NotAction": "@@PROVISIONER_TAG_EXEMPT_ACTIONS", "Resource": "*",
      "Condition": { "StringEquals": { "aws:ResourceTag/atl:component": "platform" } } },
    { "Sid": "ProtectComponentTag", "Effect": "Deny", "Action": "*", "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestTag/atl:component": "platform" } } },
    { "Sid": "PrincipalWritesNeedWorkloadBoundary", "Effect": "Deny",
      "Action": ["iam:CreateRole", "iam:CreateUser", "iam:PutRolePermissionsBoundary", "iam:AttachRolePolicy", "iam:DetachRolePolicy",
                 "iam:PutRolePolicy", "iam:DeleteRolePolicy", "iam:AttachUserPolicy", "iam:DetachUserPolicy", "iam:PutUserPolicy",
                 "iam:DeleteUserPolicy"],
      "Resource": "*",
      "Condition": { "StringNotEquals": { "iam:PermissionsBoundary": "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/ATLWorkloadBoundary" } } },
    { "Sid": "NoBoundaryRemoval", "Effect": "Deny",
      "Action": ["iam:DeleteRolePermissionsBoundary", "iam:DeleteUserPermissionsBoundary", "iam:PutUserPermissionsBoundary"], "Resource": "*" },
    { "Sid": "PassOnlyLabRoles", "Effect": "Deny", "Action": "iam:PassRole",
      "NotResource": ["arn:${AWS::Partition}:iam::*:role/CloudAlbum*", "arn:${AWS::Partition}:iam::*:role/*cloudalbum-*",
                      "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/ATLWorkstationRole"] },
    { "Sid": "AssumeOnlyLabRoles", "Effect": "Deny", "Action": "sts:AssumeRole",
      "NotResource": ["arn:${AWS::Partition}:iam::${AWS::AccountId}:role/CloudAlbum*", "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/*cloudalbum-*"] }
  ]
}
