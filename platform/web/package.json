{
  "name": "@atl/web",
  "version": "0.1.0",
  "private": true,
  "description": "ATL platform SPA (React 18 + Vite + react-router, docs/platform/08-ui-design.md): route table P00–P13, design system (src/ui), API client, SessionSync event poller, Cognito hosted login / dev tokens.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node public-pages/build.mjs",
    "build:public": "node public-pages/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@atl/shared": "0.1.0",
    "@atl/ssm-client": "0.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^26.1.0",
    "vite": "^7.1.9"
  }
}
