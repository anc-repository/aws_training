{
  "//": "Browser code only (no Node types). Config files and scripts: tsconfig.node.json. @atl/shared resolves to its sources, so no prior build is needed.",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["vite/client"],
    "paths": {
      "@atl/shared": ["../shared/src/index.ts"],
      "@atl/ssm-client": ["../ssm-client/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
