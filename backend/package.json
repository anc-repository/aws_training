{
  "name": "@cloudalbum/backend",
  "version": "0.1.0",
  "private": true,
  "description": "CloudAlbum API / worker / CLI (Express 5 + Knex + ports & adapters).",
  "type": "module",
  "main": "./dist/server.js",
  "bin": {
    "cloudalbum": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node --enable-source-maps dist/server.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "cli": "tsx src/cli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-acm": "^3.1142.0",
    "@aws-sdk/client-budgets": "^3.1142.0",
    "@aws-sdk/client-cloudfront": "^3.900.0",
    "@aws-sdk/client-cloudwatch": "^3.1142.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1142.0",
    "@aws-sdk/client-cognito-identity": "^3.1142.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.900.0",
    "@aws-sdk/client-cost-explorer": "^3.1142.0",
    "@aws-sdk/client-ec2": "^3.1142.0",
    "@aws-sdk/client-elasticache": "^3.900.0",
    "@aws-sdk/client-eventbridge": "^3.900.0",
    "@aws-sdk/client-iam": "^3.900.0",
    "@aws-sdk/client-lambda": "^3.900.0",
    "@aws-sdk/client-rds": "^3.900.0",
    "@aws-sdk/client-route-53": "^3.1142.0",
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/client-secrets-manager": "^3.900.0",
    "@aws-sdk/client-sesv2": "^3.1142.0",
    "@aws-sdk/client-sns": "^3.1142.0",
    "@aws-sdk/client-sqs": "^3.900.0",
    "@aws-sdk/client-ssm": "^3.900.0",
    "@aws-sdk/client-sts": "^3.900.0",
    "@aws-sdk/client-wafv2": "^3.1142.0",
    "@aws-sdk/credential-providers": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@cloudalbum/contracts": "0.1.0",
    "@cloudalbum/image-core": "0.1.0",
    "@node-rs/argon2": "^2.0.2",
    "aws-jwt-verify": "^5.0.0",
    "better-sqlite3": "^12.4.1",
    "commander": "^14.0.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "ioredis": "^5.8.1",
    "jose": "^6.1.0",
    "knex": "^3.1.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "otplib": "^12.0.1",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "ulid": "^3.0.1",
    "undici": "^7.16.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "aws-sdk-client-mock": "^4.1.0",
    "supertest": "^7.1.4"
  }
}
