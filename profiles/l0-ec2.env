# profiles/l0-ec2.env — L0 baseline (modular-design.md 10.2, Lab 0 part 1): only the ec2 base module.
# Every switch at its default = local implementation; IAM_CREDENTIALS=none (no AWS API call, no AWS SDK loaded).
# `scripts/module profile apply l0-ec2` disables every module in reverse topological order (data migrated back),
# then run the L0 smoke test (total outline 2.9):  npm run exp -- ec2 --scenario smoke --label l0
PROFILE_NAME=l0-ec2
PROFILE_EXTENDS=
PROFILE_MODULES=
PROFILE_DRIVERS=
PROFILE_PARAMS=
PROFILE_LOCAL_SETTINGS=
PROFILE_OPTIONAL=
PROFILE_PREREQUISITES=
PROFILE_GATED=
PROFILE_HOURLY_BILLED=
PROFILE_LAB_BYPASS=on
