# /etc/systemd/system/cloudalbum-api@.service — owned by ec2; installed but NOT enabled in L0.
# The load-balancer local tier (LB_LOCAL_WORKERS=2) enables cloudalbum-api@3001 and rewrites cloudalbum_upstream.conf.
# Identical to cloudalbum-api.service except PORT=%i. run-hostsetup.sh copies api drop-ins to cloudalbum-api@.service.d/ too.
[Unit]
Description=CloudAlbum API process on :%i
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/cloudalbum

[Service]
Type=simple
User=cloudalbum
Group=cloudalbum
UMask=0027
WorkingDirectory=/opt/cloudalbum/backend
Environment=NODE_ENV=production
Environment=CLOUDALBUM_ROLE=api
Environment=CLOUDALBUM_ENV_DIR=/etc/cloudalbum
Environment=PORT=%i
ExecStart=/usr/bin/node --enable-source-maps dist/server.js
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=78
TimeoutStopSec=20
LimitNOFILE=65536
RuntimeDirectory=cloudalbum
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cloudalbum
ReadOnlyPaths=/var/lib/cloudalbum/etc

[Install]
WantedBy=multi-user.target
